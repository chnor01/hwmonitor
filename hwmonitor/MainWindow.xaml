<Window x:Class="hwmonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:hwmonitor"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        mc:Ignorable="d"
        Title="HWMONITOR" Height="1000" Width="1200">

	<Window.Resources>
		<Style TargetType="TextBlock">
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="FontFamily" Value="Segoe UI"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="HorizontalAlignment" Value="Center"/>
		</Style>
		<Style TargetType="Border" x:Key="ChartCard">
			<Setter Property="Background" Value="#1E1E1E"/>
			<Setter Property="CornerRadius" Value="10"/>
			<Setter Property="Padding" Value="12"/>
			<Setter Property="Margin" Value="8"/>
		</Style>
		<Style TargetType="lvc:CartesianChart">
			<Setter Property="Background" Value="#1E1E1E"/>
		</Style>
        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border"
                        Background="#1E1E1E"
                        Padding="16,8" 
                        Margin="3">
                            <ContentPresenter ContentSource="Header" 
                                      TextBlock.Foreground="#888888"
                                      TextBlock.FontFamily="Segoe UI"
                                      TextBlock.FontWeight="SemiBold"
                                      TextBlock.FontSize="13"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#2A2A2A"/>
                                <Setter TargetName="Border" Property="BorderThickness" Value="0,0,0,2"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#4A90D9"/>
                                <Setter Property="TextBlock.Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#252525"/>
                                <Setter Property="TextBlock.Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Track Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#444444" CornerRadius="3"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>


	<Grid Background="#121212">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2A2A2A">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>
				<StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
					<Rectangle Width="30" Height="30" Fill="#0D1B2A" Margin="0,0,6,0"/>
					<TextBlock Text="CPU" Foreground="#888888"/>
				</StackPanel>
				<TextBlock Grid.Column="1"  Text="{Binding CpuLoadText}"/>
				<TextBlock Grid.Column="2"  Text="{Binding CpuTempText}"/>
				<TextBlock Grid.Column="3"  Text="{Binding CpuPowerText}"/>
                <Border Grid.Column="4"  Width="1" Background="#737373" Margin="8,12"/>
				<StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Center">
					<Rectangle Width="30" Height="30" Fill="#1A0D2A" Margin="0,0,6,0"/>
					<TextBlock Text="GPU" Foreground="#888888"/>
				</StackPanel>
				<TextBlock Grid.Column="6"  Text="{Binding GpuCoreLoadText}"/>
				<TextBlock Grid.Column="7"  Text="{Binding GpuCoreTempText}"/>
				<TextBlock Grid.Column="8"  Text="{Binding GpuPowerText}"/>
				<Border Grid.Column="9"  Width="1" Background="#737373" Margin="8,12"/>
				<StackPanel Grid.Column="10" Orientation="Horizontal" HorizontalAlignment="Center">
					<Rectangle Width="30" Height="30" Fill="#0D2A1A" Margin="0,0,6,0"/>
					<TextBlock Text="RAM" Foreground="#888888"/>
				</StackPanel>
				<TextBlock Grid.Column="11" Text="{Binding RamUsedGBText}"/>
                <Border Grid.Column="12"  Width="1" Background="#737373" Margin="8,12"/>
                <StackPanel Grid.Column="13" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Rectangle Width="30" Height="30" Fill="#80410b" Margin="0,0,6,0"/>
                    <TextBlock Text="Storage" Foreground="#888888"/>
                </StackPanel>
                <TextBlock Grid.Column="14"  Text="{Binding StorageReadRateText}"/>
                <TextBlock Grid.Column="15"  Text="{Binding StorageWriteRateText}"/>
                <Button Grid.Column="16" Content="⚙" Click="OpenSettingsWindow" Background="DimGray" BorderBrush="Transparent" Foreground="LightGray" Cursor="Hand"/>
			</Grid>
		</Border>

        <TabControl Grid.Row="1" Background="#121212" BorderBrush="Transparent">
            <TabItem Header="CPU">
                <Grid Background="#121212">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="150"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Row="0" Grid.ColumnSpan="3" Background="#0D1B2A" Margin="8,8,8,0" CornerRadius="10" Padding="16,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding HardwareInfo.CpuName}" Foreground="White" FontSize="14"/>
                            <Border Width="1" Background="#333333" Margin="12,0"/>
                            <TextBlock Text="{Binding HardwareInfo.CpuCores, StringFormat='{}{0} Cores'}" Foreground="#888888"/>
                            <Border Width="1" Background="#333333" Margin="12,0"/>
                            <TextBlock Text="{Binding HardwareInfo.CpuThreads, StringFormat='{}{0} Threads'}" Foreground="#888888"/>
                            <Border Width="1" Background="#333333" Margin="12,0"/>
                            <TextBlock Text="{Binding HardwareInfo.CpuBaseClock, StringFormat='{}{0} MHz'}" Foreground="#888888"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource ChartCard}" Background="#0D1B2A">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top">
                                <TextBlock Text="Utilization"/>
                                <TextBlock Text="{Binding CpuLoadText}" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="20" FontWeight="Normal" Foreground="LightGray"/>
                            </DockPanel>
                            <lvc:CartesianChart Series="{Binding CpuLoadSeries}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes0to100Percent}" Background="#0D1B2A"/>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource ChartCard}" Background="#0D1B2A">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top">
                                <TextBlock Text="Temperature"/>
                                <TextBlock Text="{Binding CpuTempText}" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="20" FontWeight="Normal" Foreground="LightGray"/>
                            </DockPanel>
                            <lvc:CartesianChart Series="{Binding CpuTempSeries}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes0to120Temp}" Background="#0D1B2A"/>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource ChartCard}" Background="#0D1B2A">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top">
                                <TextBlock Text="Power Consumption"/>
                                <TextBlock Text="{Binding CpuPowerText}" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="20" FontWeight="Normal" Foreground="LightGray"/>
                            </DockPanel>
                            <lvc:CartesianChart Series="{Binding CpuPowerSeries}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes0to160Watts}" Background="#0D1B2A"/>
                        </DockPanel>
                    </Border>
                    <Border Grid.Row="2" Grid.ColumnSpan="1" Background="#1A1A1A" Margin="8,0,8,8" CornerRadius="10" Padding="12">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBlock Text="Alerts" FontSize="13" FontWeight="SemiBold" Foreground="#888888" HorizontalAlignment="Left"/>
                            </DockPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding CpuAlerts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,3">
                                                <TextBlock Text="{Binding Time}" Foreground="#555555" Width="70"/>
                                                <TextBlock Text="{Binding Title}" Foreground="{Binding Color}" Width="70"/>
                                                <TextBlock Text="{Binding Message}" Foreground="#AAAAAA" HorizontalAlignment="Left"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="GPU">

                <Grid Background="#121212">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="150"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Row="0" Grid.ColumnSpan="3" Background="#1A0D2A" Margin="8,8,8,0" CornerRadius="10" Padding="16,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding HardwareInfo.GpuName}" Foreground="White" FontSize="14"/>
                            <Border Width="1" Background="#333333" Margin="12,0"/>
                            <TextBlock Text="{Binding HardwareInfo.GpuMemoryGB, StringFormat='{}{0}GB VRAM'}" Foreground="#888888"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource ChartCard}" Background="#1A0D2A">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top">
                                <TextBlock Text="Utilization"/>
                                <TextBlock Text="{Binding GpuCoreLoadText}" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="20" FontWeight="Normal" Foreground="LightGray"/>
                            </DockPanel>
                            <lvc:CartesianChart Series="{Binding GpuLoadSeries}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes0to100Percent}" Background="#1A0D2A"/>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource ChartCard}" Background="#1A0D2A">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top">
                                <TextBlock Text="Core Temperature"/>
                                <TextBlock Text="{Binding GpuCoreTempText}" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="20" FontWeight="Normal" Foreground="LightGray"/>
                            </DockPanel>
                            <lvc:CartesianChart Series="{Binding GpuCoreTempSeries}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes0to120Temp}" Background="#1A0D2A"/>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource ChartCard}" Background="#1A0D2A">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top">
                                <TextBlock Text="Memory Temperature"/>
                                <TextBlock Text="{Binding GpuMemoryTempText}" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="20" FontWeight="Normal" Foreground="LightGray"/>
                            </DockPanel>
                            <lvc:CartesianChart Series="{Binding GpuMemoryTempSeries}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes0to120Temp}" Background="#1A0D2A"/>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource ChartCard}" Background="#1A0D2A">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top">
                                <TextBlock Text="Hotspot Temperature"/>
                                <TextBlock Text="{Binding GpuHotspotTempText}" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="20" FontWeight="Normal" Foreground="LightGray"/>
                            </DockPanel>
                            <lvc:CartesianChart Series="{Binding GpuHotspotTempSeries}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes0to120Temp}" Background="#1A0D2A"/>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource ChartCard}" Background="#1A0D2A">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top">
                                <TextBlock Text="Power Consumption"/>
                                <TextBlock Text="{Binding GpuPowerText}" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="20" FontWeight="Normal" Foreground="LightGray"/>
                            </DockPanel>
                            <lvc:CartesianChart Series="{Binding GpuPowerSeries}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes0to200Watts}" Background="#1A0D2A"/>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource ChartCard}" Background="#1A0D2A">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top">
                                <TextBlock Text="Memory Usage"/>
                                <TextBlock Text="{Binding GpuMemoryUsedGBText}" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="20" FontWeight="Normal" Foreground="LightGray"/>
                            </DockPanel>
                            <lvc:CartesianChart Series="{Binding GpuMemoryUsageSeries}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes0to100Percent}" Background="#1A0D2A"/>
                        </DockPanel>
                    </Border>
                    <Border Grid.Row="3" Grid.ColumnSpan="1" Background="#1A1A1A" Margin="8,0,8,8" CornerRadius="10" Padding="12">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBlock Text="Alerts" FontSize="13" FontWeight="SemiBold" Foreground="#888888" HorizontalAlignment="Left"/>
                            </DockPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding GpuAlerts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,3">
                                                <TextBlock Text="{Binding Time}" Foreground="#555555" Width="70" HorizontalAlignment="Left"/>
                                                <TextBlock Text="{Binding Title}" Foreground="{Binding Color}" Width="70" HorizontalAlignment="Left"/>
                                                <TextBlock Text="{Binding Message}" Foreground="#AAAAAA" HorizontalAlignment="Left"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Memory">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="150"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Row="0" Grid.ColumnSpan="3" Background="#0D2A1A" Margin="8,8,8,0" CornerRadius="10" Padding="16,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding HardwareInfo.RamGB, StringFormat='{}{0}GB'}" Foreground="White" FontSize="14"/>
                            <Border Width="1" Background="#333333" Margin="12,0"/>
                            <TextBlock Text="{Binding HardwareInfo.RamSpeed, StringFormat='{}{0} MHz'}" Foreground="#888888"/>
                            <Border Width="1" Background="#333333" Margin="12,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource ChartCard}" Background="#0D2A1A">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top">
                                <TextBlock Text="RAM Usage"/>
                                <TextBlock Text="{Binding RamUsedGBText}" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="20" FontWeight="Normal" Foreground="LightGray"/>
                            </DockPanel>
                            <lvc:CartesianChart Series="{Binding RamSeries}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes0to100Percent}" Background="#0D2A1A"/>
                        </DockPanel>
                    </Border>
                    <Border Grid.Row="2" Grid.ColumnSpan="1" Background="#1A1A1A" Margin="8,0,8,8" CornerRadius="10" Padding="12">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBlock Text="Alerts" FontSize="13" FontWeight="SemiBold" Foreground="#888888" HorizontalAlignment="Left"/>
                            </DockPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding RamAlerts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,3">
                                                <TextBlock Text="{Binding Time}" Foreground="#555555" Width="70" HorizontalAlignment="Left"/>
                                                <TextBlock Text="{Binding Title}" Foreground="{Binding Color}" Width="70" HorizontalAlignment="Left"/>
                                                <TextBlock Text="{Binding Message}" Foreground="#AAAAAA" HorizontalAlignment="Left"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Storage">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="150"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Row="0" Grid.ColumnSpan="3" Background="#80410b" Margin="8,8,8,0" CornerRadius="10" Padding="16,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding HardwareInfo.StorageName}" Foreground="White" FontSize="14"/>
                            <Border Width="1" Background="#333333" Margin="12,0"/>
                            <TextBlock Text="{Binding HardwareInfo.StorageGB, StringFormat='{}{0:F0}GB'}" Foreground="#888888"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource ChartCard}" Background="#80410b">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top">
                                <TextBlock Text="Read Rate"/>
                                <TextBlock Text="{Binding StorageReadRateText}" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="20" FontWeight="Normal" Foreground="LightGray"/>
                            </DockPanel>
                            <lvc:CartesianChart Series="{Binding StorageReadRateSeries}" XAxes="{Binding XAxes}" YAxes="{Binding YAxesReadWrite7000MBs}" Background="#80410b"/>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource ChartCard}" Background="#80410b">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top">
                                <TextBlock Text="Write Rate"/>
                                <TextBlock Text="{Binding StorageWriteRateText}" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="20" FontWeight="Normal" Foreground="LightGray"/>
                            </DockPanel>
                            <lvc:CartesianChart Series="{Binding StorageWriteRateSeries}" XAxes="{Binding XAxes}" YAxes="{Binding YAxesReadWrite7000MBs}" Background="#80410b"/>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource ChartCard}" Background="#80410b">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top">
                                <TextBlock Text="Composite Temperature"/>
                                <TextBlock Text="{Binding StorageCompTempText}" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="20" FontWeight="Normal" Foreground="LightGray"/>
                            </DockPanel>
                            <lvc:CartesianChart Series="{Binding StorageCompTempSeries}" XAxes="{Binding XAxes}" YAxes="{Binding YAxesStorageTemp0to90C}" Background="#80410b"/>
                        </DockPanel>
                    </Border>
                    <Border Grid.Row="2" Grid.ColumnSpan="1" Background="#1A1A1A" Margin="8,0,8,8" CornerRadius="10" Padding="12">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBlock Text="Alerts" FontSize="13" FontWeight="SemiBold" Foreground="#888888" HorizontalAlignment="Left"/>
                            </DockPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding StorageAlerts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,3">
                                                <TextBlock Text="{Binding Time}" Foreground="#555555" Width="70" HorizontalAlignment="Left"/>
                                                <TextBlock Text="{Binding Title}" Foreground="{Binding Color}" Width="70" HorizontalAlignment="Left"/>
                                                <TextBlock Text="{Binding Message}" Foreground="#AAAAAA" HorizontalAlignment="Left"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
                
            </TabItem>
        </TabControl>
    </Grid>
</Window>
