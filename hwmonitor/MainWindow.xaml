<Window x:Class="hwmonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:hwmonitor"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="1000" Width="1200"
        Background="Black">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="DemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style TargetType="Border" x:Key="ChartCard">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="16"/>
        </Style>
        <Style TargetType="lvc:CartesianChart">
            <Setter Property="Background" Value="#1E1E1E"/>
        </Style>
    </Window.Resources>


    <Grid Background="#121212">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource ChartCard}">
            <StackPanel>
                <DockPanel>
                    <TextBlock Text="CPU Load"/>
                    <TextBlock Text="{Binding CpuLoadText}" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="20" FontWeight="Normal" Foreground="LightGray"/>
                </DockPanel>
                <lvc:CartesianChart Height="160" Series="{Binding CpuLoadSeries}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes0to100Percent}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource ChartCard}">
            <StackPanel>
                <DockPanel>
                    <TextBlock Text="CPU Temp"/>
                    <TextBlock Text="{Binding CpuTempText}" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="20" FontWeight="Normal" Foreground="LightGray"/>
                </DockPanel>
                <lvc:CartesianChart Height="160" Series="{Binding CpuTempSeries}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes0to150Temp}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource ChartCard}">
            <StackPanel>
                <DockPanel>
                    <TextBlock Text="CPU Power"/>
                    <TextBlock Text="{Binding CpuPowerText}" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="20" FontWeight="Normal" Foreground="LightGray"/>
                </DockPanel>
                <lvc:CartesianChart Height="160" Series="{Binding CpuPowerSeries}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes0to250Watts}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="0" Grid.Column="3" Style="{StaticResource ChartCard}">
            <StackPanel>
                <DockPanel>
                    <TextBlock Text="GPU Core Load"/>
                    <TextBlock Text="{Binding GpuCoreLoadText}" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="20" FontWeight="Normal" Foreground="LightGray"/>
                </DockPanel>
                <lvc:CartesianChart Height="160" Series="{Binding GpuLoadSeries}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes0to100Percent}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource ChartCard}">
            <StackPanel>
                <DockPanel>
                    <TextBlock Text="GPU Core Temp"/>
                    <TextBlock Text="{Binding GpuCoreTempText}" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="20" FontWeight="Normal" Foreground="LightGray"/>
                </DockPanel>
                <lvc:CartesianChart Height="160" Series="{Binding GpuCoreTempSeries}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes0to150Temp}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource ChartCard}">
            <StackPanel>
                <DockPanel>
                    <TextBlock Text="GPU Memory Temp"/>
                    <TextBlock Text="{Binding GpuMemoryTempText}" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="20" FontWeight="Normal" Foreground="LightGray"/>
                </DockPanel>
                <lvc:CartesianChart Height="160" Series="{Binding GpuMemoryTempSeries}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes0to150Temp}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource ChartCard}">
            <StackPanel>
                <DockPanel>
                    <TextBlock Text="GPU Hotspot Temp"/>
                    <TextBlock Text="{Binding GpuHotspotTempText}" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="20" FontWeight="Normal" Foreground="LightGray"/>
                </DockPanel>
                <lvc:CartesianChart Height="160" Series="{Binding GpuHotspotTempSeries}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes0to150Temp}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="3" Style="{StaticResource ChartCard}">
            <StackPanel>
                <DockPanel>
                    <TextBlock Text="GPU Power"/>
                    <TextBlock Text="{Binding GpuPowerText}" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="20" FontWeight="Normal" Foreground="LightGray"/>
                </DockPanel>
                <lvc:CartesianChart Height="160" Series="{Binding GpuPowerSeries}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes0to250Watts}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource ChartCard}">
            <StackPanel>
                <DockPanel>
                    <TextBlock Text="GPU Memory"/>
                    <TextBlock Text="{Binding GpuMemoryUsedGBText}" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="20" FontWeight="Normal" Foreground="LightGray"/>
                </DockPanel>
                <lvc:CartesianChart Height="160" Series="{Binding GpuMemoryUsageSeries}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes0to100Percent}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource ChartCard}">
            <StackPanel>
                <DockPanel>
                    <TextBlock Text="RAM"/>
                    <TextBlock Text="{Binding RamUsedGBText}" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="20" FontWeight="Normal" Foreground="LightGray"/>
                </DockPanel>
                <lvc:CartesianChart Height="160" Series="{Binding RamSeries}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes0to100Percent}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
