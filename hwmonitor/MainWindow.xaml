<Window x:Class="hwmonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:hwmonitor"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="1000" Width="1200"
        Background="Black">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Border" x:Key="ChartCard">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="8"/>
        </Style>
        <Style TargetType="lvc:CartesianChart">
            <Setter Property="Background" Value="#1E1E1E"/>
        </Style>
    </Window.Resources>


    <Grid Background="#121212">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="4" Background="#1A1A1A">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"  Text="CPU" Foreground="#888888"/>
                <TextBlock Grid.Column="1"  Text="{Binding CpuLoadText}"/>
                <TextBlock Grid.Column="2"  Text="{Binding CpuTempText}"/>
                <TextBlock Grid.Column="3"  Text="{Binding CpuPowerText}"/>
                <Border Grid.Column="4"  Width="1" Background="#333333" Margin="8,12"/>
                <TextBlock Grid.Column="5"  Text="GPU" Foreground="#888888"/>
                <TextBlock Grid.Column="6"  Text="{Binding GpuCoreLoadText}"/>
                <TextBlock Grid.Column="7"  Text="{Binding GpuCoreTempText}"/>
                <TextBlock Grid.Column="8"  Text="{Binding GpuPowerText}"/>
                <Border Grid.Column="9"  Width="1" Background="#333333" Margin="8,12"/>
                <TextBlock Grid.Column="10" Text="RAM" Foreground="#888888"/>
                <TextBlock Grid.Column="11" Text="{Binding RamUsedGBText}"/>
            </Grid>
        </Border>
        

        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource ChartCard}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top">
                    <TextBlock Text="CPU Load"/>
                    <TextBlock Text="{Binding CpuLoadText}" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="20" FontWeight="Normal" Foreground="LightGray"/>
                </DockPanel>
                <lvc:CartesianChart Series="{Binding CpuLoadSeries}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes0to100Percent}"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource ChartCard}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top">
                    <TextBlock Text="CPU Temp"/>
                    <TextBlock Text="{Binding CpuTempText}" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="20" FontWeight="Normal" Foreground="LightGray"/>
                </DockPanel>
                <lvc:CartesianChart Series="{Binding CpuTempSeries}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes0to150Temp}"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource ChartCard}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top">
                    <TextBlock Text="CPU Power"/>
                    <TextBlock Text="{Binding CpuPowerText}" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="20" FontWeight="Normal" Foreground="LightGray"/>
                </DockPanel>
                <lvc:CartesianChart Series="{Binding CpuPowerSeries}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes0to250Watts}"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="3" Style="{StaticResource ChartCard}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top">
                    <TextBlock Text="GPU Core Load"/>
                    <TextBlock Text="{Binding GpuCoreLoadText}" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="20" FontWeight="Normal" Foreground="LightGray"/>
                </DockPanel>
                <lvc:CartesianChart Series="{Binding GpuLoadSeries}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes0to100Percent}"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource ChartCard}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top">
                    <TextBlock Text="GPU Core Temp"/>
                    <TextBlock Text="{Binding GpuCoreTempText}" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="20" FontWeight="Normal" Foreground="LightGray"/>
                </DockPanel>
                <lvc:CartesianChart Series="{Binding GpuCoreTempSeries}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes0to150Temp}"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource ChartCard}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top">
                    <TextBlock Text="GPU Memory Temp"/>
                    <TextBlock Text="{Binding GpuMemoryTempText}" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="20" FontWeight="Normal" Foreground="LightGray"/>
                </DockPanel>
                <lvc:CartesianChart Series="{Binding GpuMemoryTempSeries}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes0to150Temp}"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource ChartCard}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top">
                    <TextBlock Text="GPU Hotspot Temp"/>
                    <TextBlock Text="{Binding GpuHotspotTempText}" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="20" FontWeight="Normal" Foreground="LightGray"/>
                </DockPanel>
                <lvc:CartesianChart Series="{Binding GpuHotspotTempSeries}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes0to150Temp}"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Grid.Column="3" Style="{StaticResource ChartCard}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top">
                    <TextBlock Text="GPU Power"/>
                    <TextBlock Text="{Binding GpuPowerText}" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="20" FontWeight="Normal" Foreground="LightGray"/>
                </DockPanel>
                <lvc:CartesianChart Series="{Binding GpuPowerSeries}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes0to250Watts}"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="3" Grid.Column="0" Style="{StaticResource ChartCard}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top">
                    <TextBlock Text="GPU Memory"/>
                    <TextBlock Text="{Binding GpuMemoryUsedGBText}" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="20" FontWeight="Normal" Foreground="LightGray"/>
                </DockPanel>
                <lvc:CartesianChart Series="{Binding GpuMemoryUsageSeries}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes0to100Percent}"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource ChartCard}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top">
                    <TextBlock Text="RAM"/>
                    <TextBlock Text="{Binding RamUsedGBText}" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="20" FontWeight="Normal" Foreground="LightGray"/>
                </DockPanel>
                <lvc:CartesianChart Series="{Binding RamSeries}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes0to100Percent}"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
